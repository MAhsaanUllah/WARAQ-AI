# ============================================================
# Waraq AI — environment configuration
# Copy to .env and fill in your values. NEVER commit .env.
# All settings are read with the WARAQAI_ prefix (app/core/config.py).
# ============================================================

# ---------- Qdrant ----------
# Local Dockerized instance (default). For Qdrant Cloud, set the URL + API key.
WARAQAI_QDRANT_URL=http://localhost:6333
# Empty = local instance, no auth
WARAQAI_QDRANT_API_KEY=

# ---------- LLM (BYOK — bring your own key) ----------
# Provider: deepseek | gemini | openai | anthropic | openrouter
WARAQAI_LLM_PROVIDER=deepseek
# Your API key. LiteLLM routes it to the provider above.
WARAQAI_LLM_API_KEY=
# Leave empty for the provider's default model.
# Examples: deepseek/deepseek-chat | gemini/gemini-2.0-flash |
#           openai/gpt-4o-mini | anthropic/claude-sonnet-4-20250514
WARAQAI_LLM_MODEL=

# ---------- Chunking (Stage 1) ----------
WARAQAI_CHUNK_SIZE=800
WARAQAI_CHUNK_OVERLAP=150

# ---------- Retrieval (Stages 3-4) ----------
# Candidates fused from dense+sparse via RRF, before reranking
WARAQAI_TOP_K_CANDIDATES=25
# High-precision chunks after reranking, injected into the LLM context
WARAQAI_TOP_K_FINAL=5

# ---------- API ----------
# Comma-separated allowed origins (Vite dev server by default; add your
# Netlify/Render frontend URL in production)
WARAQAI_CORS_ORIGINS=http://localhost:5173
WARAQAI_LOG_LEVEL=INFO

# ---------- Auth (Clerk — multi-tenancy) ----------
# Secret key from Clerk Dashboard → API Keys (sk_test_... / sk_live_...)
WARAQAI_CLERK_SECRET_KEY=
# Comma-separated origins allowed to use this token (Clerk JWT azp check)
WARAQAI_CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:8000

# ---------- Web Search (BYOK, optional) ----------
# Provider: tavily | brave (set via Settings UI at runtime; or here for boot)
# WARAQAI_SEARCH_PROVIDER=tavily
# WARAQAI_SEARCH_API_KEY=
