# Clerk publishable key (safe to expose in the browser).
# Get it from Clerk Dashboard → API Keys → Publishable key.
# Copy this file to .env and fill in.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Backend API base URL (for the Vite dev proxy fallback / production fetch).
# In dev the Vite proxy sends /api → http://localhost:8000 automatically.
# On Netlify, set this to your Render backend URL, e.g.
# https://waraq-ai-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000
